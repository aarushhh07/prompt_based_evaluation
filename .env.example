# ─── Google Cloud / Vertex AI ───────────────────────────────────────
# Credentials are handled by Application Default Credentials (ADC).
# Run: gcloud auth application-default login
# The following are optional overrides (defaults are in config.py):

GCP_PROJECT=<YOUR_PROJECT_ID>
GCP_LOCATION=us-central1

# ─── Alternative LLM Providers (uncomment if not using Gemini) ──────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...          # Only needed if vertexai=False
